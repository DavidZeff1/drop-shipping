data/store*.json
data/*.local.json
data/exports/
*.html
!playbooks/*.html

# Generated shop: the folder you upload, and the notes that come with it
site/
*.notes.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Secrets
.env
.env.*
!.env.example

# Photos uploaded through the admin
data/photos/
